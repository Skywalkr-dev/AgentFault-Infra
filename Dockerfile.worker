FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY agent/ agent/
COPY trajectory/ trajectory/
COPY injector/ injector/
COPY replay/ replay/
COPY worker/ worker/
COPY data/ data/

ENV WORKER_PORT=8080
ENV WORKER_BATCH_SIZE=8
EXPOSE 8080

CMD ["sh", "-c", "uvicorn worker.api:app --host 0.0.0.0 --port ${WORKER_PORT}"]
